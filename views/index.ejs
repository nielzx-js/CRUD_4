<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>inicio</title>
    <style>
        .form2{
            margin-top: 100px;
        }
    </style>
</head>
<body>
    <table border="1px">
    <thead>
        <tr>
            <td>ID</td>
            <td>Título</td>
            <td>Descrição</td>
            <td>Editar</td>
            <td>Excluir</td>
        </tr>
    </thead>
    <tbody>
        <% tarefas.forEach(tarefa=>{ %>
        <tr>
            <td><%=tarefa.id%></td>
            <td><%=tarefa.titulo%></td>
            <td><%=tarefa.descricao%></td>
            <td><button type="button" onclick="window.location.href='/edit/<%=tarefa.id%>'">Editar</button></td>

            <td>
                <form action="/delete/<%=tarefa.id%>" method="post">
                    <button type="submit">Excluir</button>
                </form>
                
            </td>
        </tr>
        <%})%>
      
    </tbody>
    </table>
  <form class="form2" method="post" action="/add">
            <label for="titulo">Insira um título: </label><br>
            <input type="text" maxlength="100" name="titulo" required><br>
            <label for="descricao">Insira uma Descrição</label><br>
            <textarea name="descricao"></textarea><br>
            <button type="submit">Enviar</button>
        </form>
</body>
</html>